msgid "Review this element against WCAG 2.2 guidelines and apply the recommended remediation."
msgstr ""

#: src/Rules/RuleCatalog.php:64
msgid "Add missing language attribute"
msgstr ""

#: src/Rules/RuleCatalog.php:65
msgid "Sets a lang attribute on the <html> element when one is missing (WCAG 3.1.1)."
msgstr ""

#: src/Rules/RuleCatalog.php:68
msgid "Add a skip-to-content link"
msgstr ""

#: src/Rules/RuleCatalog.php:69
msgid "Inserts a keyboard skip link at the top of every page on classic themes; block themes already get one from WordPress (WCAG 2.4.1)."
msgstr ""

#: src/Rules/RuleCatalog.php:72
msgid "Add a visible focus outline"
msgstr ""

#: src/Rules/RuleCatalog.php:73
msgid "Ensures links and controls show a clear outline when focused with the keyboard (WCAG 2.4.7)."
msgstr ""

#: src/Rules/RuleCatalog.php:76
msgid "Underline links in content"
msgstr ""

#: src/Rules/RuleCatalog.php:77
msgid "Underlines in-content links so they are not distinguished by color alone (WCAG 1.4.1)."
msgstr ""

#: src/Rules/RuleCatalog.php:80
msgid "Warn about links opening new windows"
msgstr ""

#: src/Rules/RuleCatalog.php:81
msgid "Appends a hidden \"(opens in a new window)\" notice to target=\"_blank\" links (WCAG 3.2.5)."
msgstr ""

#: src/Rules/RuleCatalog.php:84
msgid "Allow zooming (fix viewport)"
msgstr ""

#: src/Rules/RuleCatalog.php:85
msgid "Removes user-scalable=no and maximum-scale limits so users can zoom (WCAG 1.4.4)."
msgstr ""

#: src/Rules/RuleCatalog.php:88
msgid "Remove positive tabindex values"
msgstr ""

#: src/Rules/RuleCatalog.php:89
msgid "Resets tabindex values greater than 0 to keep a natural focus order (WCAG 2.4.3)."
msgstr ""

#: src/Rules/RuleCatalog.php:92
msgid "Add labels to search forms"
msgstr ""

#: src/Rules/RuleCatalog.php:93
msgid "Adds an accessible label to the classic get_search_form() field; the Search block is already labelled (WCAG 3.3.2)."
msgstr ""

#: src/Rules/RuleCatalog.php:96
msgid "Remove redundant title attributes"
msgstr ""

#: src/Rules/RuleCatalog.php:97
msgid "Strips title attributes from links, buttons and fields that already have another accessible name."
msgstr ""

