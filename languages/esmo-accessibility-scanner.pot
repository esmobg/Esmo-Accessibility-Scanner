msgid "4.1.2 Name, Role, Value"
msgstr ""

#: src/Rules/RuleCatalog.php:291
msgid "Give the select element an accessible name via a label or aria-label."
msgstr ""

#: src/Rules/RuleCatalog.php:300
msgid "Remove ARIA attributes that are not allowed for the element role."
msgstr ""

#: src/Rules/RuleCatalog.php:307
msgid "Use an ARIA role that is allowed for this element."
msgstr ""

#: src/Rules/RuleCatalog.php:314
msgid "Add the ARIA attributes required by this role."
msgstr ""

#: src/Rules/RuleCatalog.php:321
msgid "Ensure the role contains its required child roles."
msgstr ""

#: src/Rules/RuleCatalog.php:328
msgid "Ensure the role is contained within its required parent role."
msgstr ""

#: src/Rules/RuleCatalog.php:335
msgid "Use a valid ARIA role value."
msgstr ""

#: src/Rules/RuleCatalog.php:342
msgid "Correct the misspelled or invalid ARIA attribute name."
msgstr ""

#: src/Rules/RuleCatalog.php:349
msgid "Provide a valid value for the ARIA attribute."
msgstr ""

#: src/Rules/RuleCatalog.php:356
msgid "Do not set aria-hidden=\"true\" on the document <body>."
msgstr ""

#: src/Rules/RuleCatalog.php:363
msgid "Do not place focusable elements inside aria-hidden=\"true\" containers."
msgstr ""

#: src/Rules/RuleCatalog.php:370
msgid "Provide an accessible name for the ARIA command (button, link, menuitem)."
msgstr ""

#: src/Rules/RuleCatalog.php:377
msgid "Provide an accessible name for the ARIA input field."
msgstr ""

#: src/Rules/RuleCatalog.php:384
msgid "Provide an accessible name for the ARIA toggle field."
msgstr ""

#: src/Rules/RuleCatalog.php:390
#: src/Rules/RuleCatalog.php:397
#: src/Rules/RuleCatalog.php:404
msgid "4.1.1 Parsing"
msgstr ""

#: src/Rules/RuleCatalog.php:393
msgid "Ensure id values referenced by ARIA are unique within the document."
msgstr ""

#: src/Rules/RuleCatalog.php:400
msgid "Ensure id values on active elements are unique within the document."
msgstr ""

#: src/Rules/RuleCatalog.php:407
msgid "Ensure every id attribute is unique within the document."
msgstr ""

#: src/Rules/RuleCatalog.php:416
msgid "Ensure the headers attribute references valid header cell ids in the same table."
msgstr ""

#: src/Rules/RuleCatalog.php:423
msgid "Ensure each <th> is associated with data cells, or use a layout that does not rely on it."
msgstr ""

#: src/Rules/RuleCatalog.php:430
msgid "Use a valid scope value (row, col, rowgroup, colgroup) on header cells."
msgstr ""

#: src/Rules/RuleCatalog.php:437
msgid "Ensure the table caption and summary do not duplicate each other."
msgstr ""

#: src/Rules/RuleCatalog.php:444
msgid "Provide text content for table header cells."
msgstr ""

#: src/Rules/RuleCatalog.php:450
#: src/Rules/RuleCatalog.php:457
#: src/Rules/RuleCatalog.php:464
msgid "3.1.1 Language of Page"
msgstr ""

#: src/Rules/RuleCatalog.php:453
msgid "Add a lang attribute to the <html> element identifying the page language."
msgstr ""

#: src/Rules/RuleCatalog.php:460
msgid "Use a valid BCP 47 language code in the lang attribute."
msgstr ""

#: src/Rules/RuleCatalog.php:467
msgid "Ensure lang and xml:lang attributes agree."
msgstr ""

#: src/Rules/RuleCatalog.php:471
msgid "3.1.2 Language of Parts"
msgstr ""

#: src/Rules/RuleCatalog.php:474
msgid "Use a valid language code on inline lang attributes."
msgstr ""

#: src/Rules/RuleCatalog.php:483
msgid "Wrap page content in landmark regions (main, nav, header, footer)."
msgstr ""

#: src/Rules/RuleCatalog.php:490
msgid "Provide exactly one <main> landmark on the page."
msgstr ""

#: src/Rules/RuleCatalog.php:497
msgid "Avoid more than one main landmark on the page."
msgstr ""

#: src/Rules/RuleCatalog.php:504
msgid "Give landmarks of the same type unique accessible names."
msgstr ""

#: src/Rules/RuleCatalog.php:513
msgid "Provide discernible text or an aria-label for the button."
msgstr ""

#: src/Rules/RuleCatalog.php:520
msgid "Do not nest interactive controls inside other interactive controls."
msgstr ""

#: src/Rules/RuleCatalog.php:526
msgid "2.4.2 Page Titled"
msgstr ""

#: src/Rules/RuleCatalog.php:529
msgid "Provide a non-empty, descriptive <title> for the page."
msgstr ""

#: src/Rules/RuleCatalog.php:533
msgid "2.4.1 Bypass Blocks"
msgstr ""

#: src/Rules/RuleCatalog.php:536
msgid "Provide a skip link or landmarks so keyboard users can bypass repeated content."
msgstr ""

#: src/Rules/RuleCatalog.php:543
msgid "Provide a descriptive title attribute for each <iframe>."
msgstr ""

#: src/Rules/RuleCatalog.php:547
msgid "1.4.4 Resize Text"
msgstr ""

#: src/Rules/RuleCatalog.php:550
msgid "Remove user-scalable=no and maximum-scale limits so users can zoom the page."
msgstr ""

#: src/Rules/RuleCatalog.php:554
msgid "2.4.3 Focus Order"
msgstr ""

#: src/Rules/RuleCatalog.php:557
msgid "Avoid positive tabindex values; rely on natural DOM order for focus."
msgstr ""

#: src/Rules/RuleCatalog.php:566
msgid "Make sure <ul> and <ol> elements only directly contain <li>, <script> or <template> elements."
msgstr ""

#: src/Rules/RuleCatalog.php:573
msgid "Place every <li> element inside a <ul>, <ol> or an element with role=\"list\"."
msgstr ""

#: src/Rules/RuleCatalog.php:580
msgid "Make sure <dl> elements only contain properly ordered <dt> and <dd> groups, <script>, <template> or <div> elements."
msgstr ""

#: src/Rules/RuleCatalog.php:587
msgid "Place <dt> and <dd> elements inside a <dl> element."
msgstr ""

#: src/Rules/RuleCatalog.php:594
msgid "Use real heading elements (<h2>, <h3>, ...) instead of styling paragraphs to look like headings."
msgstr ""

#: src/Rules/RuleCatalog.php:603
msgid "Give input buttons discernible text with the value attribute, aria-label or aria-labelledby."
msgstr ""

#: src/Rules/RuleCatalog.php:610
msgid "Give every <summary> element discernible text."
msgstr ""

#: src/Rules/RuleCatalog.php:614
#: src/Rules/RuleCatalog.php:621
#: src/Rules/RuleCatalog.php:658
msgid "2.1.1 Keyboard"
msgstr ""

#: src/Rules/RuleCatalog.php:617
msgid "Make scrollable regions reachable by keyboard, for example with tabindex=\"0\" and an accessible name."
msgstr ""

#: src/Rules/RuleCatalog.php:624
msgid "Do not set tabindex=\"-1\" on frames that contain focusable content."
msgstr ""

#: src/Rules/RuleCatalog.php:628
msgid "2.5.8 Target Size (Minimum)"
msgstr ""

#: src/Rules/RuleCatalog.php:631
msgid "Make touch targets at least 24 by 24 CSS pixels, or leave enough space around smaller targets."
msgstr ""

#: src/Rules/RuleCatalog.php:635
msgid "1.3.4 Orientation"
msgstr ""

#: src/Rules/RuleCatalog.php:638
msgid "Do not lock content to portrait or landscape orientation with CSS."
msgstr ""

#: src/Rules/RuleCatalog.php:642
msgid "1.4.12 Text Spacing"
msgstr ""

#: src/Rules/RuleCatalog.php:645
msgid "Do not use !important on inline line-height, letter-spacing or word-spacing styles, so users can adjust text spacing."
msgstr ""

#: src/Rules/RuleCatalog.php:654
msgid "Give elements with role=\"img\" an accessible name using aria-label or aria-labelledby."
msgstr ""

#: src/Rules/RuleCatalog.php:661
msgid "Replace server-side image maps with client-side image maps or regular links."
msgstr ""

#: src/Rules/RuleCatalog.php:665
msgid "1.2.2 Captions (Prerecorded)"
msgstr ""

#: src/Rules/RuleCatalog.php:668
msgid "Provide captions for video with a <track kind=\"captions\"> element."
msgstr ""

#: src/Rules/RuleCatalog.php:672
msgid "1.2.1 Audio-only and Video-only (Prerecorded)"
msgstr ""

#: src/Rules/RuleCatalog.php:675
msgid "Provide a transcript or captions for audio content."
msgstr ""

#: src/Rules/RuleCatalog.php:679
#: src/Rules/RuleCatalog.php:686
msgid "2.2.2 Pause, Stop, Hide"
msgstr ""

#: src/Rules/RuleCatalog.php:682
msgid "Remove <blink> elements; blinking content distracts and cannot be paused."
msgstr ""

#: src/Rules/RuleCatalog.php:689
msgid "Remove <marquee> elements or replace them with content users can pause."
msgstr ""

#: src/Rules/RuleCatalog.php:693
msgid "2.2.1 Timing Adjustable"
msgstr ""

#: src/Rules/RuleCatalog.php:696
msgid "Do not refresh or redirect the page automatically with <meta http-equiv=\"refresh\">."
msgstr ""

#: src/Rules/RuleCatalog.php:705
msgid "Associate every data cell in large tables with a header cell (<th> or headers attribute)."
msgstr ""

#: src/Rules/RuleCatalog.php:714
msgid "Give elements with role=\"meter\" an accessible name."
msgstr ""

#: src/Rules/RuleCatalog.php:721
msgid "Give elements with role=\"progressbar\" an accessible name."
msgstr ""

#: src/Rules/RuleCatalog.php:728
msgid "Give elements with role=\"tooltip\" discernible text."
msgstr ""

#: src/Rules/RuleCatalog.php:735
msgid "Give elements with role=\"treeitem\" an accessible name."
msgstr ""

#: src/Rules/RuleCatalog.php:742
msgid "Replace deprecated ARIA roles with a current role."
msgstr ""

#: src/Rules/RuleCatalog.php:751
msgid "Do not nest the banner (site header) landmark inside another landmark."
msgstr ""

#: src/Rules/RuleCatalog.php:758
msgid "Do not nest the contentinfo (site footer) landmark inside another landmark."
msgstr ""

#: src/Rules/RuleCatalog.php:765
msgid "Do not nest the main landmark inside another landmark."
msgstr ""

#: src/Rules/RuleCatalog.php:772
msgid "Keep complementary (aside) landmarks at the top level of the page."
msgstr ""

#: src/Rules/RuleCatalog.php:779
msgid "Use only one banner (site header) landmark per page."
msgstr ""

#: src/Rules/RuleCatalog.php:786
msgid "Use only one contentinfo (site footer) landmark per page."
msgstr ""

#: src/Rules/RuleCatalog.php:793
msgid "Make sure the skip link points to an element that exists on the page."
msgstr ""

#: src/Rules/RuleCatalog.php:802
msgid "Replace generic link text such as \"click here\" or \"read more\" with text that describes the destination."
msgstr ""

#: src/Rules/RuleCatalog.php:809
msgid "Do not rely on placeholder text as the only label. Add a persistent visible label."
msgstr ""

#: src/Rules/RuleCatalog.php:813
msgid "3.2.5 Change on Request"
msgstr ""

#: src/Rules/RuleCatalog.php:816
msgid "Warn users when a link opens in a new window, for example by appending \"(opens in new window)\" to the link text."
msgstr ""

